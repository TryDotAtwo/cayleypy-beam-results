{
  "name": "cayleypy-external-solutions",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"CONTEXT_VERSION": "cube555-kaggle-v1"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cayleypy-external-solutions",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": {"enabled": false}
}
